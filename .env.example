# LaunchReadyy Community — local configuration
#
# Copy to `.env` and fill in your own values. `launchreadyy setup` writes this
# file for you; editing it by hand is equally fine.
#
# Nothing here points at LaunchReadyy infrastructure. There is no account to
# create and no telemetry. Only GITHUB_TOKEN is needed for repository features;
# everything else is optional and degrades to "disabled", never to an error.
#
# Generate secrets with:  openssl rand -hex 32
#
# Precedence: once `launchreadyy setup` has run, `data/config.json` is authoritative
# and `.env` becomes the fallback plus the transport into the server process. Both are
# written by `launchreadyy config`, so prefer that over hand-editing — a `.env` edit
# that disagrees with config.json is ignored (and `launchreadyy doctor` says so).

# ── Core local application ───────────────────────────────────────────────────
# Signs local sessions. Required.
SESSION_SECRET=

# Encrypts project environment variables at rest (AES-GCM) before they are
# stored in SQLite and shipped to a sandbox run. Required if you use sandbox
# verification with project env vars. Changing it makes existing values
# unreadable.
ENV_VAR_ENCRYPTION_SECRET=

# Where this installation is reachable. Defaults to http://localhost:5174.
# Set VITE_APP_URL as well when serving behind a proxy: absolute URLs rendered by
# the browser bundle (og:, canonical, share links) read VITE_APP_URL at build time.
APP_URL=http://localhost:5174
VITE_APP_URL=

# ── Server binding ───────────────────────────────────────────────────────────
# Loopback by default. LaunchReadyy has no login of its own and holds your GitHub,
# AI and E2B credentials, so only bind elsewhere behind an authenticating proxy —
# `launchreadyy start --host 0.0.0.0` warns when you do.
HOST=localhost
PORT=5174

# ── GitHub (required for repository features) ────────────────────────────────
# A personal access token you create at https://github.com/settings/tokens
# Scopes: repo, read:user, workflow
# There is no OAuth app to register. The token is read server-side only and is
# never sent to the browser. Revoke it in GitHub whenever you like.
GITHUB_TOKEN=

# Display identity for this installation. Cosmetic only — never verified.
LOCAL_USER_LOGIN=
LOCAL_USER_EMAIL=
LOCAL_USER_AVATAR_URL=

# ── Optional: E2B sandbox verification ───────────────────────────────────────
# Runs install/build/lint/test for a repo in an isolated sandbox, turning a
# static finding into verified evidence. Leave unset and sandbox steps are
# reported as skipped — scanning, scoring and template fixes all still work.
# Key from https://e2b.dev
E2B_API_KEY=
# Optional custom template with more CPU/RAM than the default, for large repos.
E2B_TEMPLATE_ID=

# ── Optional: AI provider ────────────────────────────────────────────────────
# Only needed for generated fixes, generated tests and AI-assisted remediation.
# Deterministic scanning, scoring, Production Security and template fixes need
# no AI at all. Configure ONE provider: deepseek | anthropic | openai | gemini | cursor
AI_PROVIDER=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CURSOR_API_KEY=

# Optional model overrides. Leave unset to use the shipped defaults.
# CLAUDE_MODEL / CLAUDE_FAST_MODEL / CLAUDE_OPUS_MODEL pick the Anthropic model per
# workload (default, cheap/high-volume, hardest). The rest are single-provider.
# CLAUDE_MODEL=
# CLAUDE_FAST_MODEL=
# CLAUDE_OPUS_MODEL=
# DEEPSEEK_MODEL=
# DEEPSEEK_REASONER_MODEL=
# OPENAI_MODEL=
# GEMINI_MODEL=
# CURSOR_MODEL=

# ── Optional: operations ─────────────────────────────────────────────────────
# Concurrency cap for sandbox verification (defaults to a small value suitable for
# a laptop). Raise only if the machine and your E2B account can support it.
SANDBOX_MAX_CONCURRENT=
# Set to `1` to disable rate limiting (not recommended outside a trusted local demo).
RATE_LIMIT_DISABLED=

# ── Optional: public metadata ────────────────────────────────────────────────
PUBLIC_GITHUB_URL=https://github.com/g0GobliN/launchreadyy
VITE_PUBLIC_GITHUB_URL=
# Origin used when building shareable launch-report links. Falls back to APP_URL.
PUBLIC_APP_URL=
