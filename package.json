{
  "name": "launchreadyy",
  "version": "1.0.0",
  "description": "LaunchReadyy Community — self-hosted production-readiness and verification tool for software repositories",
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "launchreadyy": "dist/cli/index.js"
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --host",
    "build": "node scripts/ensure-wasm.mjs && vite build && npm run build:cli",
    "build:cli": "tsx src/cli/build.ts",
    "start": "node dist/server/server.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fixtures": "vitest run src/lib/fixtures-matrix.test.ts && npx tsx scripts/verify-fixtures-minimal.ts",
    "test:production-start": "tsx scripts/verify-production-start.ts",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "format": "prettier --write .",
    "verify:licensing": "node scripts/verify-licensing.mjs",
    "verify:tools": "vitest run --config vitest.audit.config.ts scripts/verify-fix-tools.ts",
    "verify:mobile": "vitest run --config vitest.audit.config.ts scripts/verify-real-project.ts",
    "rust:build": "cargo build --release --manifest-path rust/Cargo.toml",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml",
    "wasm:build": "wasm-pack build rust/crates/indexer --target web -- --features wasm",
    "e2b:build:dev": "node --env-file=.env --import tsx launchreadyy/build.dev.ts",
    "e2b:build:prod": "node --env-file=.env --import tsx launchreadyy/build.prod.ts",
    "bench:indexer": "tsx scripts/bench-indexer.ts",
    "bench:imports": "tsx scripts/bench-imports.ts",
    "bench:indexer:disk": "tsx scripts/bench-indexer-disk.ts",
    "docs:build": "node scripts/build-docs.js",
    "docs:check": "node scripts/build-docs.js check",
    "predev": "node scripts/preflight.mjs node",
    "prebuild": "node scripts/preflight.mjs node",
    "pretest": "node scripts/preflight.mjs node",
    "prelint": "node scripts/preflight.mjs node",
    "pretest:e2e:smoke": "node scripts/preflight.mjs node playwright",
    "preverify:tools": "node scripts/preflight.mjs node docker",
    "pree2b:build:dev": "node scripts/preflight.mjs node e2b",
    "pree2b:build:prod": "node scripts/preflight.mjs node e2b"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@clack/prompts": "^0.11.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.50",
    "@tanstack/router-plugin": "^1.167.28",
    "@types/better-sqlite3": "^7.6.13",
    "baseline-browser-mapping": "^2.11.25",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0",
    "e2b": "2.32.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "input-otp": "^1.4.2",
    "lru-cache": "^11.5.1",
    "lucide-react": "^0.575.0",
    "open": "^10.2.0",
    "openai": "^6.42.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.185.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "browserslist": "^4.29.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "js-yaml": "^5.4.2",
    "nitro": "3.0.260429-beta",
    "playwright": "^1.62.1",
    "prettier": "^3.7.3",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "e2b": "2.32.0",
    "esbuild": "^0.28.2"
  }
}
