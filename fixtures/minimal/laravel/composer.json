{
  "name": "fx/laravel",
  "description": "Minimal Laravel-shaped fixture for detection + sandbox install",
  "require": {
    "php": ">=8.2",
    "laravel/framework": "^11.31"
  },
  "config": {
    "audit": {
      "block-insecure": false
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
