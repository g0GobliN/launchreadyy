# Refuse to install on the wrong Node. `engines.node` alone is a warning, and a warning is easy to
# miss: installing under Node 18 succeeds, then `npm run dev` dies with "crypto.hash is not a
# function" from inside Vite and `npm run build` fails mid-build. CI pins Node 22, and .nvmrc pins
# it locally, so failing here is the cheapest place to say it.
engine-strict=true
