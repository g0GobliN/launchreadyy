# Public site build settings.
#
# `VITE_SITE_URL` is the origin the site is served from, without a trailing slash. It is required
# for a real deployment: canonical, og:url, og:image, and twitter:image need an absolute origin, and
# when it is unset those tags are omitted from the build rather than pointed at a guess.
#
# Vercel: set it under Project → Settings → Environment Variables, then rebuild.
VITE_SITE_URL=
