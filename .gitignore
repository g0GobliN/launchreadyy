.env
.env.*
!.env.example

# Local database — runtime state created by the app, never source
data/*.db
data/*.sqlite
data/*.db-shm
data/*.db-wal
data/*.db-journal
data/*.sqlite-shm
data/*.sqlite-wal
data/*.sqlite-journal

# Local CLI configuration (may contain tokens/keys)
data/config.json

# npm pack test artifact — never commit
*.tgz

# Editor / agent tooling state
.freebuff/
.utim_tmp/
.tmp-debug.mjs

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
