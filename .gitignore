# Rust (v2 indexer) — build output only; source + Cargo.lock are tracked
rust/target/
rust/crates/indexer/pkg/
**/*.rs.bk
# Fixture local build caches (never commit)
fixtures/**/.gradle/
fixtures/**/target/
fixtures/**/*.class
.scratch/
